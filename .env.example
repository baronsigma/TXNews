# ─── TXNews Environment Variables ────────────────────────────────────────────
# Copy to .env and fill in real values before running docker-compose up

# ─── EC2 / Server ────────────────────────────────────────────────────────────
EC2_PUBLIC_IP=YOUR_EC2_IP_HERE

# ─── MySQL Root Password ──────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_strong_root_pass

# ─── Per-site DB Passwords ────────────────────────────────────────────────────
DB_PASS_CELINA=change_me_celina
DB_PASS_ANNA=change_me_anna
DB_PASS_PRINCETON=change_me_princeton
DB_PASS_FATE=change_me_fate
DB_PASS_MELISSA=change_me_melissa
DB_PASS_FULSHEAR=change_me_fulshear

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_USER=admin
N8N_PASSWORD=change_me_n8n_pass

# ─── WordPress Application Passwords ─────────────────────────────────────────
# Generate via: WP Admin → Users → Profile → Application Passwords
# Format: "xxxx xxxx xxxx xxxx xxxx xxxx" (spaces are fine, URL-encode in workflows)
WP_APP_PASS_CELINA="xxxx xxxx xxxx xxxx xxxx xxxx"
WP_APP_PASS_ANNA="xxxx xxxx xxxx xxxx xxxx xxxx"
WP_APP_PASS_PRINCETON="xxxx xxxx xxxx xxxx xxxx xxxx"
WP_APP_PASS_FATE="xxxx xxxx xxxx xxxx xxxx xxxx"
WP_APP_PASS_MELISSA="xxxx xxxx xxxx xxxx xxxx xxxx"
WP_APP_PASS_FULSHEAR="xxxx xxxx xxxx xxxx xxxx xxxx"

# ─── Ollama (running on EC2 host, NOT in Docker) ──────────────────────────────
# Accessible from Docker containers via host gateway IP
OLLAMA_HOST=http://172.17.0.1:11434
# Pull the model before first run: ollama pull qwen2.5:3b
